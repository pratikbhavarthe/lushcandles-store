# Copy to .env and fill in. Never commit .env.
# Full reference: docs/environment-variables.md

# --- Database -------------------------------------------------------------
# Local Homebrew Postgres uses the OS user or "postgres" without a password.
DATABASE_URL=postgres://postgres@localhost:5432/medusa-lushcandles-store
DB_NAME=medusa-lushcandles-store

# --- Redis ----------------------------------------------------------------
# When set, medusa-config.ts registers the Redis event bus, locking,
# workflow engine and caching modules. Leave empty to fall back to the
# in-memory modules (single process, development only).
REDIS_URL=redis://localhost:6379

# --- CORS (comma-separated origins, no trailing slash) ---------------------
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3000

# --- Secrets --------------------------------------------------------------
# Generate each with: openssl rand -hex 32
# medusa-config.ts refuses to start in production if these are missing or
# left at a known default.
JWT_SECRET=
COOKIE_SECRET=
# Optional. Encrypts admin MFA secrets. Generate with: openssl rand -hex 32
AUTH_MFA_ENCRYPTION_KEY=
