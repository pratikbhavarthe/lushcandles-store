# Copy to .env.local and fill in. Never commit .env.local.
# Full reference: docs/environment-variables.md
#
# Everything prefixed NEXT_PUBLIC_ is inlined into the browser bundle.
# Only put public values there. Never place admin tokens or secret keys
# in this file.

# Publishable API key (pk_...). Admin > Settings > Publishable API Keys.
# It must be linked to the sales channel that sells your products.
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Medusa backend URL
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Country code used when the visitor's country is not served by any region
NEXT_PUBLIC_DEFAULT_REGION=in

# Public storefront URL (canonical URLs, sitemap.xml, robots.txt)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional payment provider public keys. Leave empty when unused.
NEXT_PUBLIC_STRIPE_KEY=
NEXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NEXT_PUBLIC_ADYEN_CLIENT_KEY=
NEXT_PUBLIC_ADYEN_ENVIRONMENT=test

# Optional, only for S3-hosted product images
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
